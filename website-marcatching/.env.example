NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
MIDTRANS_SERVER_KEY=your_midtrans_server_key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
NEXT_PUBLIC_MIDTRANS_ENV=sandbox
APPS_SCRIPT_PAYMENT_SECRET=your_random_payment_webhook_secret
NEXT_PUBLIC_APPS_SCRIPT_URL=your_main_apps_script_web_app_url
AFFILIATE_ATTRIBUTION_SECRET=your_random_32_byte_affiliate_secret
AFFILIATE_DATA_ENCRYPTION_KEY=your_64_character_hex_encryption_key
FINANCE_APPS_SCRIPT_URL=your_finance_apps_script_url

# AI Brand Memory refinement (server-side only). Free key: https://aistudio.google.com/apikey
# Free-tier content may be used by Google to improve its products; switch to a paid key before scaling.
GEMINI_API_KEY=
# Optional overrides. Models are tried in order until one answers (free-tier Gemini is often overloaded):
# GEMINI_MODEL (if set) -> gemini-3.6-flash -> gemini-3.5-flash-lite -> gemini-3.1-flash-lite -> gemini-3.8-flash
# GEMINI_MODEL=gemini-3.6-flash
# LLM_PROVIDER=gemini

# Member landing pages (page.marcatching.com/<brand>): public Cloudflare R2 bucket for photos.
# PAGES_R2_PUBLIC_URL is the bucket's custom domain, no trailing slash. Needs the landing_pages migration in supabase/.
PAGES_R2_ACCOUNT_ID=
PAGES_R2_ACCESS_KEY_ID=
PAGES_R2_SECRET_ACCESS_KEY=
PAGES_R2_BUCKET_NAME=marcatching-pages
PAGES_R2_PUBLIC_URL=https://assets.marcatching.com
